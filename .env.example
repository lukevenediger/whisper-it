# Copy to .env and fill in. Docker-compose auto-loads .env from this directory.
# Nothing here is required for basic transcription -- only set what you need.

# --- Cloud speaker attribution ---
# Uses OpenRouter to call an LLM that names the speakers in a transcript. Optional.
# Enable by setting this to 1
WHISPER_DIARIZE=
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Parakeet v3 (default engine) ---
# Parakeet is the default model. These rarely need changing.
# Whisper model used when a Parakeet request forces a language Parakeet can't do
# (anything outside its 25 European languages -- e.g. Japanese, Chinese, Arabic).
WHISPER_PARAKEET_FALLBACK_MODEL=small
# onnx-asr model id for Parakeet. Override only to pin a different Parakeet build.
WHISPER_PARAKEET_MODEL=nemo-parakeet-tdt-0.6b-v3

# --- WhatsApp transcription (WAHA) ---
# Send/forward voice notes to a WhatsApp number and get the transcription back.
# The `waha` service in docker-compose.yml provides the WhatsApp link.
# Leave WAHA_API_KEY blank to disable auth between whisper-it and WAHA (fine on a
# private compose network). Set a value to require it.
WAHA_API_KEY=
# How whisper-it reaches WAHA. Default works with the bundled compose service.
# Unset this entirely to turn the WhatsApp feature OFF.
WAHA_BASE_URL=http://waha:3000
# WAHA session name (one WhatsApp number per session).
WAHA_SESSION=default
# Webhook HMAC secret. Set this to any random string to authenticate webhooks:
# compose passes it to WAHA as WHATSAPP_HOOK_HMAC_KEY (WAHA signs each webhook)
# and to whisper-it as WHATSAPP_WEBHOOK_SECRET (whisper-it verifies the signature,
# rejecting unsigned/forged webhooks with 401). Leave blank to disable (webhooks
# unauthenticated — fine only on a fully private network). Strongly recommended.
WHATSAPP_WEBHOOK_SECRET=
# WAHA dashboard creds (reachable only inside the compose network).
WAHA_DASHBOARD_USERNAME=waha
WAHA_DASHBOARD_PASSWORD=waha
# After `make run`, open http://localhost:4000/whatsapp.html to scan the QR,
# manage the number whitelist, and view per-sender usage stats.

# --- Debug mode (dev convenience) ---
# Exposes tests/fixtures/audio/* in a "Run fixture" dropdown in the UI so you can
# kick off transcription against a known file without dragging from your desktop.
# Off in production. Compose mounts tests/fixtures/audio:/fixtures:ro automatically.
WHISPER_DEBUG_FIXTURES=0
